# Copy to .env in the project root (same folder as app.json)
# Restart Expo after changes: npx expo start -c

# REQUIRED for mobile data (4G/5G) — must be a public URL, NOT localhost or 192.168.x.x
# Production (recommended):
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api

# Temporary: tunnel via ngrok (dev only) — example:
# EXPO_PUBLIC_API_URL=https://abc123.ngrok-free.app/api

# Wi‑Fi-only (same LAN as your PC) — will NOT work on cellular:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:5000/api

EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
EXPO_PUBLIC_APP_NAME=WarZone Free Fire Tournament
