{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://stunning-glorifier-panama.ngrok-free.dev/api",
        "EXPO_PUBLIC_APP_NAME": "WAREZONE Tournament"
      },
      "android": {
        "releaseChannel": "production",
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "releaseChannel": "production"
      }
    },
    "preview": {
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://stunning-glorifier-panama.ngrok-free.dev/api",
        "EXPO_PUBLIC_APP_NAME": "WAREZONE Tournament"
      },
      "android": {
        "releaseChannel": "preview",
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
