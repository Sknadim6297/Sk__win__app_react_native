# Copy to backend/.env

MONGODB_URI=mongodb://127.0.0.1:27017/sk-win
# OR MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sk-win?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=5000
NODE_ENV=development

# Public HTTPS URL for ZapUPI webhook (ngrok or Render).
# Alias also accepted: BACKEND_URL
PUBLIC_BASE_URL=https://stunning-glorifier-panama.ngrok-free.dev
# BACKEND_URL=https://stunning-glorifier-panama.ngrok-free.dev

# Marketing website (sk-win-web). API /download redirects here — do not use the old APK HTML page.
# FRONTEND_URL=https://sk-win-web.onrender.com
# WEBSITE_URL=https://sk-win-web.onrender.com

# --- Master payment switch ---
# Set true to use ZapUPI for wallet top-up and tournament join.
PAYMENT_ENABLED=false

# Optional: trust proxy when behind nginx/caddy
# TRUST_PROXY=1

# --- ZapUPI (TEST first) ---
# Keep ZAPUPI_KEY on the server only. Never put it in the React Native app.
ZAPUPI_ENABLED=true
ZAPUPI_ENV=test
ZAPUPI_KEY=
# Alias also accepted: ZAPUPI_ZAP_KEY=
ZAPUPI_MIN_AMOUNT=1
ZAPUPI_MAX_AMOUNT=10000
# Optional: restrict wallet top-ups to these amounts only (comma-separated). Empty = any amount in range.
# ZAPUPI_ALLOWED_TOPUP_AMOUNTS=100,500,1000
# Webhook URL to set in ZapUPI dashboard:
#   {PUBLIC_BASE_URL}/api/payments/zapupi/webhook

# --- Support contacts ---
SUPPORT_EMAIL=support@warzoneff.com
SUPPORT_PHONE=+91 6297616918

# --- Password reset OTP (users + admins, same flow) ---
# App UI: Email OTP is live. WhatsApp + SMS show Coming Soon until configured.
# Without SMTP, OTP is logged on the API server and returned as debugOtp when OTP_DEBUG=true
# (or automatically in non-production).
# OTP_DEBUG=true
#
# Email OTP (REQUIRED for real inbox delivery — Gmail App Password works well):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM=WAREZONE <your@gmail.com>
#
# Aliases also accepted: MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASSWORD, MAIL_FROM
#
# WhatsApp OTP (Coming Soon until set — Twilio WhatsApp sandbox/prod):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
#
# SMS OTP (Coming Soon until set):
# FAST2SMS_API_KEY=
# — or —
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1XXXXXXXXXX
#
# Legacy admin email reset-link (optional; OTP flow is preferred):
# ADMIN_EMAIL=sknadim6297@gmail.com
# ADMIN_RESET_DEEPLINK_URL=warezone://admin-reset-password
# ADMIN_RESET_WEB_URL=https://YOUR_DOMAIN/admin/#/reset-password

# --- Google Sign-In (same OAuth client IDs as app EXPO_PUBLIC_GOOGLE_*) ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
