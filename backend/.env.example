# Copy to backend/.env

MONGODB_URI=mongodb://127.0.0.1:27017/sk-win
# OR MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sk-win?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=5000
NODE_ENV=development

# Public URL for uploaded images — must match what phones use (HTTPS in production).
# NOT a LAN IP if users connect via mobile data.
# Examples:
#   PUBLIC_BASE_URL=https://api.yourdomain.com
#   PUBLIC_BASE_URL=https://abc123.ngrok-free.app
PUBLIC_BASE_URL=https://api.yourdomain.com

# Optional: trust proxy when behind nginx/caddy
# TRUST_PROXY=1

# --- Cashfree Payment Gateway (Wallet QR top-up) ---
# Leave CASHFREE_ENABLED=false until Production credentials are ready.
# Then set CASHFREE_ENABLED=true and fill App ID + Secret Key.
CASHFREE_ENABLED=false
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY
# Optional alias if your dashboard labels it Client ID:
# CASHFREE_CLIENT_ID=
CASHFREE_API_VERSION=2023-08-01
# Optional: defaults to CASHFREE_SECRET_KEY
# CASHFREE_WEBHOOK_SECRET=
CASHFREE_QR_EXPIRY_MINUTES=20
# Webhook URL to configure in Cashfree dashboard:
#   {PUBLIC_BASE_URL}/api/payments/cashfree/webhook
# Enable Server-to-Server (S2S) + UPI QR in Cashfree merchant settings.
