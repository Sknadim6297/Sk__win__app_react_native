# Copy to backend/.env

MONGODB_URI=mongodb://127.0.0.1:27017/sk-win
# OR MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sk-win?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=5000
NODE_ENV=development

# Public API base for webhooks / Cashfree notify_url (ngrok or Render).
# Alias also accepted: BACKEND_URL
PUBLIC_BASE_URL=https://stunning-glorifier-panama.ngrok-free.dev
# BACKEND_URL=https://stunning-glorifier-panama.ngrok-free.dev

# --- Master payment switch ---
# Set true for Cashfree Sandbox Pay & Join / wallet QR.
PAYMENT_ENABLED=false

# Optional: trust proxy when behind nginx/caddy
# TRUST_PROXY=1

# --- Cashfree Payment Gateway (SANDBOX / Test Environment) ---
# IMPORTANT: Use keys from Payments / Payment Gateway → Developers → API Keys
# DO NOT use Payouts → API Keys — those cause 401 authentication Failed on /pg/orders.
# Keep CASHFREE_ENV=sandbox. Do NOT switch dashboard to Prod for this flow.
# Credentials stay on the backend only — never put secrets in the app.
CASHFREE_ENABLED=false
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=YOUR_SANDBOX_PAYMENT_GATEWAY_APP_ID
CASHFREE_SECRET_KEY=YOUR_SANDBOX_PAYMENT_GATEWAY_SECRET_KEY
# Optional aliases (same values as dashboard Client ID / Client Secret):
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
# Optional: defaults to CASHFREE_SECRET_KEY
# CASHFREE_WEBHOOK_SECRET=
CASHFREE_QR_EXPIRY_MINUTES=20
# Webhook URL to keep in Cashfree Test Environment (NOTIFY_URL, API 2023-08-01):
#   {PUBLIC_BASE_URL}/api/payments/cashfree/webhook
# Enable Server-to-Server (S2S) + UPI QR in Cashfree merchant settings.
# Events: SUCCESS payment (+ FAILED if available). Reuse existing ngrok webhook — do not duplicate blindly.

# --- Support contacts (player forgot-password modal) ---
SUPPORT_EMAIL=support@warzoneff.com
SUPPORT_PHONE=+91 6297616918

# --- Admin forgot-password OTP email (optional) ---
# Without SMTP, OTP is printed in the API server console (and returned as debugOtp in non-production).
# Install nodemailer if you enable SMTP: npm install nodemailer
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=WAREZONE <noreply@warezone.app>
# ADMIN_OTP_DEBUG=true

# --- Google Sign-In (same OAuth client IDs as app EXPO_PUBLIC_GOOGLE_*) ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
