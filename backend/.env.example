# Copy to backend/.env

MONGODB_URI=mongodb://127.0.0.1:27017/sk-win
# OR MongoDB Atlas:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sk-win?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=5000
NODE_ENV=development

# Public HTTPS URL for ZapUPI webhook (ngrok or Render).
# Alias also accepted: BACKEND_URL
PUBLIC_BASE_URL=https://stunning-glorifier-panama.ngrok-free.dev
# BACKEND_URL=https://stunning-glorifier-panama.ngrok-free.dev

# --- Master payment switch ---
# Set true to use ZapUPI for wallet top-up and tournament join.
PAYMENT_ENABLED=false

# Optional: trust proxy when behind nginx/caddy
# TRUST_PROXY=1

# --- ZapUPI (TEST first) ---
# Keep ZAPUPI_KEY on the server only. Never put it in the React Native app.
ZAPUPI_ENABLED=true
ZAPUPI_ENV=test
ZAPUPI_KEY=
ZAPUPI_MIN_AMOUNT=1
ZAPUPI_MAX_AMOUNT=10000
# Webhook URL to set in ZapUPI dashboard:
#   {PUBLIC_BASE_URL}/api/payments/zapupi/webhook

# --- Support contacts ---
SUPPORT_EMAIL=support@warzoneff.com
SUPPORT_PHONE=+91 6297616918

# --- Admin reset (email reset-link flow) ---
# The reset endpoints are admin-only and only send emails for the configured admin account.
# For now default is the initial admin email.
# ADMIN_EMAIL=sknadim6297@gmail.com
#
# Reset link settings
# ADMIN_RESET_DEEPLINK_URL=warezone://admin-reset-password
# ADMIN_RESET_WEB_URL=https://YOUR_DOMAIN/admin/#/reset-password
# ADMIN_RESET_TOKEN_TTL_MS=900000
#
# Rate limiting (anti-abuse)
# ADMIN_FORGOT_RATE_WINDOW_MS=900000
# ADMIN_FORGOT_RATE_MAX=5

# --- Password reset OTP (users + admins) ---
# Without a provider, OTP is printed in the API server console (and returned as debugOtp in non-production).
# OTP_DEBUG=true
# ADMIN_OTP_DEBUG=true
#
# Email (optional):
# Preferred (as requested)
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=WAREZONE <noreply@warezone.app>
#
# Optional: to use the existing OTP SMTP_* variables instead of MAIL_*:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=WAREZONE <noreply@warezone.app>
#
# SMS via Fast2SMS (India) — https://www.fast2sms.com
# FAST2SMS_API_KEY=
#
# SMS + WhatsApp via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1XXXXXXXXXX
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Google Sign-In (same OAuth client IDs as app EXPO_PUBLIC_GOOGLE_*) ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
