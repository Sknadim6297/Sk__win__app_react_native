{
  "name": "sk-win",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/prepare-pwa-icons.js && expo start --web",
    "admin:web": "node scripts/prepare-pwa-icons.js && expo start --web",
    "build": "node scripts/prepare-pwa-icons.js && expo export --platform web && node scripts/copy-pwa-public.js",
    "build:web": "node scripts/prepare-pwa-icons.js && expo export --platform web && node scripts/copy-pwa-public.js",
    "build:pwa": "node scripts/prepare-pwa-icons.js && expo export --platform web && node scripts/copy-pwa-public.js",
    "build:render-web": "node scripts/build-render-frontend.js",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "optimize:assets": "node scripts/optimize-assets.js",
    "build:android:size": "eas build --platform android --profile preview --clear-cache",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:preview": "npm --prefix website run preview",
    "preview:pwa": "npx --yes serve dist -s -l 4173",
    "apk:sync": "node scripts/sync-latest-apk.js",
    "release:prepare": "node scripts/sync-latest-apk.js && npm run website:build",
    "render:build": "npm install --prefix backend",
    "render:build:all": "npm install --prefix backend && npm install --prefix website && npm run website:build",
    "eas-build-post-install": "node scripts/strip-unused-icon-fonts.js"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.7.2",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/stack": "^7.6.1",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.7",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-picker-select": "^9.3.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "private": true,
  "devDependencies": {
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.10"
  }
}
