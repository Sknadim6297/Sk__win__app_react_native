{
  "expo": {
    "name": "WAREZONE",
    "slug": "sk-win",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo/ROUND_GAME_LOGO.png",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "extra": {
      "eas": {
        "projectId": "43e67fb1-94ec-48c2-8e78-fa94f3290cec"
      },
      "appName": "WAREZONE"
    },
    "splash": {
      "image": "./assets/logo/ROUND_GAME_LOGO.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skwin.tournament",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/ROUND_GAME_LOGO.png",
        "backgroundColor": "#0a0e1a"
      },
      "package": "com.skwin.tournament",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/logo/ROUND_GAME_LOGO.png",
      "backgroundColor": "#0a0e1a"
    },
    "androidStatusBar": {
      "backgroundColor": "#0a0e1a",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#0a0e1a"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0e1a",
          "image": "./assets/logo/ROUND_GAME_LOGO.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/dm-sans/700Bold/DMSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/dm-sans/800ExtraBold/DMSans_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/ROUND_GAME_LOGO.png",
          "color": "#22C55E",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "usesCleartextTraffic": true,
            "useLegacyPackaging": true,
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "networkInspector": false,
            "buildArchs": [
              "arm64-v8a"
            ]
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "warezone",
    "notification": {
      "icon": "./assets/logo/ROUND_GAME_LOGO.png",
      "color": "#22C55E",
      "androidMode": "default",
      "androidCollapsedTitle": "WAREZONE"
    },
    "owner": "nadim123456"
  }
}
