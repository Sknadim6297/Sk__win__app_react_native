{
  "expo": {
    "name": "WAREZONE",
    "slug": "sk-win",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/logo/WAREZONE_LOGO.png",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "extra": {
      "eas": {
        "projectId": "66dfc3ce-3f0d-4479-bc3b-fa323a96b07d"
      },
      "appName": "WAREZONE",
      "paymentEnabled": false
    },
    "splash": {
      "image": "./assets/logo/WAREZONE_LOGO.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skwin.tournament",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/WAREZONE_ADAPTIVE_FOREGROUND.png",
        "backgroundColor": "#0a0e1a"
      },
      "package": "com.skwin.tournament",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/logo/WAREZONE_LOGO.png",
      "name": "WAREZONE",
      "shortName": "WAREZONE",
      "lang": "en",
      "scope": "/",
      "themeColor": "#0a0e1a",
      "backgroundColor": "#0a0e1a",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/login",
      "bundler": "metro",
      "output": "single"
    },
    "androidStatusBar": {
      "backgroundColor": "#0a0e1a",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#0a0e1a"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0e1a",
          "image": "./assets/logo/WAREZONE_LOGO.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/saira/400Regular/Saira_400Regular.ttf",
            "./node_modules/@expo-google-fonts/saira/500Medium/Saira_500Medium.ttf",
            "./node_modules/@expo-google-fonts/saira/600SemiBold/Saira_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/saira/700Bold/Saira_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/WAREZONE_LOGO.png",
          "color": "#22C55E",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "usesCleartextTraffic": true,
            "useLegacyPackaging": true,
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "networkInspector": false,
            "buildArchs": [
              "arm64-v8a"
            ]
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "warezone",
    "notification": {
      "icon": "./assets/logo/WAREZONE_LOGO.png",
      "color": "#22C55E",
      "androidMode": "default",
      "androidCollapsedTitle": "WAREZONE"
    },
    "owner": "warzonesknadim"
  }
}
