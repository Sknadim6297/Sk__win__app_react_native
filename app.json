{
  "expo": {
    "name": "SK WIN",
    "slug": "sk-win",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/sk_win_logo.png",
    "userInterfaceStyle": "dark",
    "extra": {
      "eas": {
        "projectId": "9bf33d68-cc48-4456-9873-3cb14d624b77"
      }
    },
    "splash": {
      "image": "./assets/logo/sk_win_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skwin.tournament"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/sk_win_logo.png",
        "backgroundColor": "#0a0e1a"
      },
      "package": "com.skwin.tournament"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0a0e1a"
    },
    "androidStatusBar": {
      "backgroundColor": "#0a0e1a",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#0a0e1a"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0e1a",
          "image": "./assets/logo/sk_win_logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
