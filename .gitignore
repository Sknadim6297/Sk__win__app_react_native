# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Local toolchains (JDK etc.)
.tools/

# Expo
.expo/
.expo-safe-check/
.expo-web-check/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
android/
ios/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Local EAS / Android signing credentials (never commit)
credentials.json
credentials/
android/keystore.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (never commit secrets)
.env
.env.*
!.env.example
.env*.local
backend/.env
backend/.env.*
!backend/.env.example

# generated PWA icon (copied from assets/logo at build)
public/apple-touch-icon.png

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
