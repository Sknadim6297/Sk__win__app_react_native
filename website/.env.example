# Backend API (no trailing slash). Required for production static deploy (sk-win-web).
VITE_API_URL=https://sk-win-api.onrender.com

# Expo Web PWA (iPhone Home Screen / Safari). Same screens as the Android app.
VITE_PWA_URL=https://sk-win-pwa.onrender.com

# Optional later: native iOS listing (not used for the free PWA path)
# VITE_IOS_TESTFLIGHT_URL=https://testflight.apple.com/join/YOUR_CODE
# VITE_IOS_APP_URL=https://apps.apple.com/app/idYOUR_ID

# Local dev: Vite proxies /api to this host (see vite.config.js)
# VITE_DEV_API_PROXY=http://127.0.0.1:5000
